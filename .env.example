# Server Port (Render sets this automatically, but required for local development)
PORT=5000

# MongoDB Connection String
# Local: mongodb://127.0.0.1:27017/school_management
# Render/Production: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/school_management?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/school_management?retryWrites=true&w=majority

# JWT Settings
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# School Name
SCHOOL_NAME=My Modern School

# Default Super Admin Credentials
ADMIN_EMAIL=admin@myschool.com
ADMIN_PASSWORD=Admin@12345
